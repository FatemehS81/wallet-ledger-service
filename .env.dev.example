# Copy to .env.dev (git-ignored) to override the development defaults.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-secret-key
DB_NAME=wallet
DB_USER=wallet
DB_PASSWORD=wallet
DB_HOST=db
DB_PORT=5432
MAX_TRANSACTION_AMOUNT=1000000000000
MAX_WALLET_BALANCE=1000000000000000
SWAGGER_ENABLED=true
