# Copy to .env.prod (git-ignored) and fill in real values before `make prod-up`.
# The production settings refuse to start when a required value is missing.
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=wallet.example.com
DB_NAME=wallet
DB_USER=wallet
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432
# Values consumed by the PostgreSQL container itself.
POSTGRES_DB=wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=replace-with-a-strong-password
MAX_TRANSACTION_AMOUNT=1000000000000
MAX_WALLET_BALANCE=1000000000000000
SWAGGER_ENABLED=false
